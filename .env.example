# Azure Storage for local development (use Azurite or a dedicated dev account).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
DOCUMENTS_CONTAINER=incoming
RESULTS_CONTAINER=results
OUTPUTS_CONTAINER=outputs
JOBS_TABLE=Jobs
DOCUMENTS_TABLE=Documents
QUEUE_NAME=document-jobs
ARCHIVE_QUEUE_NAME=archive-jobs
ARCHIVES_TABLE=Archives
MAX_UPLOAD_SIZE_MB=100
MAX_BATCH_DOCUMENTS=100

# Required for Azure AI Document Intelligence processing.
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-layout
ARCHIVE_RETENTION_HOURS=24

# Local-only identity. Never enable this in production.
DEV_AUTH_ENABLED=false
DEV_USER_ID=
DEV_USER_NAME=
